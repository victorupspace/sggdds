{
  "name": "design-system-monorepo",
  "version": "0.1.0",
  "description": "Monorepo do Design System SGGD: tokens multiplataforma e biblioteca React.",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @government/design-system dev",
    "build": "pnpm -r build",
    "storybook": "pnpm tokens:build && storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "pnpm tokens:build && storybook build",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @government/design-system test:watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "tokens:build": "pnpm --filter @government/tokens build",
    "tokens:validate": "pnpm --filter @government/tokens validate",
    "tokens:clean": "pnpm --filter @government/tokens clean",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "10.0.1",
    "@government/design-system": "workspace:*",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/addon-vitest": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "axe-core": "^4.11.4",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "playwright": "1.59.1",
    "prettier": "3.8.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "rimraf": "6.1.3",
    "storybook": "10.3.6",
    "style-dictionary": "5.4.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.10",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.5",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.24.0"
  }
}
