    "disabled (.ds-button:disabled e .ds-button[aria-disabled='true']: cores disabled e cursor not-allowed; a variante tertiary mantem background transparent)",
    "loading (classe .ds-button--loading aplicada no TSX + spinner .ds-button__spinner animado, aria-busy=\"true\" e desabilitacao efetiva via isDisabled)",
    "full-width (.ds-button--full-width define inline-size: 100%)"
