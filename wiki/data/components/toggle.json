  "states": [
    "checked (.ds-toggle__input:checked + .ds-toggle__track: trilho em --toggle-track-on e thumb deslocado para a direita)",
    "hover (.ds-toggle:not(.ds-toggle--disabled):hover: trilho em --toggle-hover-track-off / --toggle-hover-track-on quando checked)",
    "focus-visible (.ds-toggle__input:focus-visible + .ds-toggle__track: outline no trilho com --toggle-focus-ring)",
    "disabled (classe .ds-toggle--disabled + atributo disabled no input: trilho, thumb, label e hint neutros, cursor not-allowed, sem box-shadow no thumb)",
    "disabled + checked (.ds-toggle--disabled .ds-toggle__input:checked + .ds-toggle__track mantem --toggle-disabled-track)",
    "required (renderiza span.ds-toggle__required com asterisco aria-hidden e aplica required no input)"
  ],
