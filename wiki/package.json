{
  "name": "sampa-ds-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wiki oficial do Sampa Design System — Governo do Estado de São Paulo / Prodesp",
  "scripts": {
    "dev": "node scripts/sync-tokens.mjs && next dev",
    "build": "node scripts/sync-tokens.mjs && next build && pagefind --site out",
    "start": "npx --yes serve out",
    "tokens:sync": "node scripts/sync-tokens.mjs && node scripts/extrair-tokens.mjs",
    "validate:data": "node scripts/validar-extracao.mjs",
    "validate:conteudo": "node scripts/validar-conteudo.mjs",
    "lint": "eslint src scripts --max-warnings 0",
    "verify": "npm run lint && npm run typecheck && npm run build && node scripts/validar-extracao.mjs && node scripts/validar-conteudo.mjs && node scripts/verificar-links.mjs && node scripts/auditar-acessibilidade.mjs --todas",
    "verify:rapido": "node scripts/validar-extracao.mjs && node scripts/validar-conteudo.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "next": "^16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "^16.3.0",
    "@types/mdx": "2.0.13",
    "@types/node": "22.10.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "pagefind": "1.4.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
